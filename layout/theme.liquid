    {% comment %}
    {% if template contains 'index' or handle == 'professionals' %}
      <div class="dots-navigation"></div>
    {% endif %}
    <script>
  // section scroll dot js start
  const dotsContainer = document.querySelector('.dots-navigation');
  const sections = document.querySelectorAll('#main .shopify-section');
  const sectionContainer = document.getElementById('main');
  
  sections.forEach((section, index) => {
    const dot = document.createElement('span');
    dot.classList.add('section-dot');
    dot.dataset.index = index;
    dot.addEventListener('click', () => {
      sections[index].scrollIntoView({ behavior: 'smooth' });
      document.querySelectorAll('.section-dot').forEach(dot => dot.classList.remove('active'));
      dot.classList.add('active');
    });
    dotsContainer.appendChild(dot);
  });
  
  function updateActiveDot() {
    let currentIndex = 0;
    const scrollPosition = window.scrollY + (window.innerHeight / 2);
  
    sections.forEach((section, index) => {
      const sectionTop = section.getBoundingClientRect().top + window.scrollY;
      const sectionBottom = sectionTop + section.offsetHeight;
      
    
      if (scrollPosition >= sectionTop && scrollPosition < sectionBottom) {
        currentIndex = index;
      }
    });
  
    document.querySelectorAll('.section-dot').forEach(dot => dot.classList.remove('active'));
    const activeDot = document.querySelector(`.section-dot[data-index="${currentIndex}"]`);
    if (activeDot) {
      activeDot.classList.add('active');
    }
  }
  
  window.addEventListener('scroll', updateActiveDot);
  sectionContainer.addEventListener('scroll', updateActiveDot);
    </script>
