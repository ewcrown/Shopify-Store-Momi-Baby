    "faq_PiR3KV": {
      "type": "faq",
      "blocks": {
        "item_DFV8qV": {
          "type": "item",
          "settings": {
            "title": "what's new about the new improved flow rate nipples?",
            "content": "<p>Our original slow and medium flow nipples had a faster flow rate than the flow rates of other major brands. We reduced the flow rate of the new versions significantly so they are now consistent with other brands.</p><p>Also, some of the original nipples were excessively drippy. We've significantly reduced the drippiness of the new version.</p><p>At this time, the slow and medium flow nipples have been modified.</p>",
            "custom-html": ""
          }
        },
        "item_ATRftf": {
          "type": "item",
          "settings": {
            "title": "how do i know which version i received?",
            "content": "<p>All orders placed directly on our store after 3PM Eastern Time on Friday, October 20 ship with the new, improved slow flow nipples (assuming the order included slow flow nipples). If you placed an order after 3PM on Friday, November 17, you received the new, improved medium nipples.</p><p>All orders placed on Amazon included the original version.</p>",
            "custom-html": ""
          }
        },
        "item_YzXwmp": {
