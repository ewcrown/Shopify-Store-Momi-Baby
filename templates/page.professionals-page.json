            "content_html": "<div class=\"WeProfessionals\">\n    <div class=\"WeProfessionalTitle\">\n        <h2>we<span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"39\" height=\"29\" viewbox=\"0 0 39 29\" fill=\"none\">\n            <path d=\"M26.0116 2.85864C23.2928 2.85864 20.8977 4.2275 19.5383 6.37857C18.1789 4.2275 15.7837 2.85864 13.0649 2.85864C8.79249 2.85864 5.29688 6.37857 5.29688 10.6807C5.29688 18.4376 19.5383 26.3248 19.5383 26.3248C19.5383 26.3248 33.7797 18.5028 33.7797 10.6807C33.7797 6.37857 30.2841 2.85864 26.0116 2.85864Z\" fill=\"#FF0099\"></path>\n          </svg></span>professionals</h2>\n    </div>\n    <div class=\"WeProfessionalPera\">\n        <p>We are your partners in the mission of supporting babies and those who feed them.</p>\n        <p>Swipe to learn more about how we support professionals through,</p>\n    </div>\n<div class=\"WeProfessionalList\">\n          <ul>\n              <li>sampling</li>\n              <li>product discounts for families</li>\n              <li>client referral network</li>\n              <li>bulk and wholesale discounts</li>\n          </ul>\n      </div>\n</div>",
            "show_rating": false,
            "rating": 4
          }
        },
        "quote_gYaT8M": {
          "type": "quote",
          "settings": {
            "class_name1": "",
            "class_name_image": "",
            "logo_width": 100,
            "video_url": "",
