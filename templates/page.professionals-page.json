            "author": "",
            "authorpro": "",
            "content": "",
            "content_html": "<div class=\"WeProfessionals\">\n    <div class=\"WeProfessionalTitle\">\n        <h2>bulk and wholesale</h2>\n    </div>\n    <div class=\"WeProfessionalPera\">\n        <p>We offer bulk and wholesale discounts to professionals and others involved in helping babies be fed.</p>\n        <p>This includes:</p>\n        <div class=\"innerlist\">\n        <ul>\n            <li>Healthcare systems making bulk purchases for use in speech language pathology and lactation support</li>\n            <li>Private practitioners who wish to include a complementary bottle as part of their overall service offering to families</li>\n            <li>Clinics that make retail product offerings available to families</li>\n        </ul>\n    </div>\n        <p style=\"margin-top: 10px;\">Email <a href=\"mailto:partners@momi.baby\">partners@momi.baby</a> to ask about our bulk and wholesale discounts.</p>\n    </div>\n</div>",
            "show_rating": false,
            "rating": 4
          }
