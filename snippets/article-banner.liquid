{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
ARTICLE BANNER COMPONENT
----------------------------------------------------------------------------------------------------------------------
Shows the blog post image with blog post summary on blog post details page. The snippet automatically adjust the image positioning based on its aspect ratio.

********************************************
Supported parameters
********************************************

* show_date
* show_author
* show_comments_count
* layout
{%- endcomment -%}

<div class="article-banner {% if layout == 'image_text_overlay' %}sm:justify-items-center sm:align-items-center{% endif %}">
    {%- if article_image != blank -%}
    {%- capture sizes -%}(max-width: 1149px) 100vw, {% if layout == 'image_text_overlay' %}min({{ settings.page_width }}px, 100vw){% elsif layout == 'content_first' %}1000px{% else %}(max-width: 1399px) calc(100vw * 0.60 - 40px), calc(min({{ settings.page_width }}px, 100vw) * 0.60 - 64px){% endif %}{%- endcapture -%}
    <div class="article-banner__image">
      {{- article_image | image_url: width: 1500 | image_tag: sizes: sizes , widths: '200,300,400,500,600,700,800,900,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200' -}}
    </div>
      {% else %}

<div class="video-wrapper VideoBlog">
	<div class="video-container" id="video-container">
		<video controls id="video1" preload="metadata" poster="{{ article.metafields.custom.blog_poster_image | file_url }}">
			<source src="{{ article.metafields.custom.blog_video | file_url }}" type="video/mp4">
		</video>

		<div class="play-button-wrapper">
			<div title="Play video" class="play-gif" id="circle-play-b1">
				<!-- SVG Play Button -->
				<svg height="CurrentHeight" width="CurrentWidth" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 80">
					<path d="M40 0a40 40 0 1040 40A40 40 0 0040 0zM26 61.56V18.44L64 40z" />
				</svg>
			</div>
		</div>
	</div>
</div> 

      
  {%- endif -%}
  <div class="article-banner__content text-custom">
    {%- if article.tags.size > 0 -%}
      <a href="{{ blog.url }}/tagged/{{ article.tags.first | handle }}" class="badge bold text-sm tagName">{{- article.tags.first -}}</a>
    {%- endif -%}

    <h1 class="h0 postTitle">{{- article.title -}}</h1>

    <div class="article__meta">

   
      {%- if show_date -%}
          
        <!-- <p class="text-with-icon">
          {% comment %}{%- render 'icon' with 'blog-date' -%}{% endcomment %} <time>published on&nbsp; {{- article.published_at | date: format: 'abbreviated_date' -}}</time>
        </p> -->
                {% if article.metafields.custom.blog_date != blank  %}
        <div class="blog_date">published on {{ article.metafields.custom.blog_date }}</div>
          {% else %}
          <div class="blog_date">published on&nbsp; {{- article.published_at | date: format: 'abbreviated_date' -}}</div>
         {% endif %}
      {%- endif -%}
  
      <span>|</span>

      <!-- {%- if show_author -%}
        <p class="text-with-icon">
          {% comment %}{%- render 'icon' with 'blog-author' -%}{{- 'blog.post.written_by' | t: author: article.author -}} {% endcomment %} 
          <span class="by-text">by</span> 
          <b class="author-name">{{ article.author }}</b>
        </p>
      {%- endif -%} -->
          {% if article.metafields.custom.blog_author != blank  %}
           
    <div class="blog_author">by {{ article.metafields.custom.blog_author }}</div>
      {% else %}
      <div class="blog_author">by {{ article.author }}</div>
      {% endif %}

      {%- if show_comments_count and article.comments_enabled? -%}
        <a href="#blog-post-comments" class="text-with-icon link-faded">
          {%- render 'icon' with 'blog-comment' -%}
          {{- 'blog.comments.count' | t: count: article.comments_count -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>