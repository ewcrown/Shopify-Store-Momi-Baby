{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
ACCORDION COMPONENT
----------------------------------------------------------------------------------------------------------------------

This component is used to create an accordion (also called as collapsible). It internally uses the "details" HTML
tag so that it can also be used without any JavaScript.

********************************************
Supported parameters
********************************************

* title: the title to use for the toggle button
* icon: an optional icon attached to the title
* content: the hidden content inside the accordion
* open: if set to true the accordion is open by default
* size: if set to "lg", the font is and spacing is bigger
* class: any additional class
* id: an optional ID for the accordion
{%- endcomment -%}

<details {% if id %}id="{{ id | escape }}"{% endif %} class="{{ class }} accordion {% if size %}accordion--{{ size }}{% endif %} group" aria-expanded="{% if open %}true{% else %}false{% endif %}" is="accordion-disclosure" {% if open %}open{% endif %} {{ block.shopify_attributes }}>
  <summary>
    {%- comment -%}iOS 14 does not support flex on the summary itself, so we have to use this extra div{%- endcomment -%}
    <div class="accordion__toggle bold">
      {%- if icon -%}
        <div class="text-with-icon">
          {%- render 'icon' with icon -%}
          <span {% if size == 'lg' %}class="h6"{% endif %}>{{- title -}}
             {% if block.settings.tab-title != blank %}
      <div class="tab-title">
       {{ block.settings.tab-title }} 
      </div>
        {% endif %}
          </span>
        </div>
      {%- else -%}
        <span {% if size == 'lg' %}class="h6"{% endif %}>{{- title -}}
           {% if block.settings.tab-title != blank %}
      <div class="tab-title">
       {{ block.settings.tab-title }} 
      </div>
        {% endif %}
        </span>
      {%- endif -%}
   

  <span class="circle-chevron group-hover:colors group-expanded:colors group-expanded:rotate pluseicon">
    {% comment %}{%- render 'icon' with 'chevron-bottom-small' -%}{% endcomment %}
    <svg xmlns="http://www.w3.org/2000/svg" width="currentWidth" height="currentHeight" viewBox="0 0 46 46" fill="none">
      <path d="M22.2943 7.98193C22.8026 7.98193 23.2901 8.18387 23.6496 8.54331C24.009 8.90276 24.2109 9.39027 24.2109 9.8986V21.3986H35.7109C36.2193 21.3986 36.7068 21.6005 37.0662 21.96C37.4257 22.3194 37.6276 22.8069 37.6276 23.3153C37.6276 23.8236 37.4257 24.3111 37.0662 24.6706C36.7068 25.03 36.2193 25.2319 35.7109 25.2319H24.2109V36.7319C24.2109 37.2403 24.009 37.7278 23.6496 38.0872C23.2901 38.4467 22.8026 38.6486 22.2943 38.6486C21.7859 38.6486 21.2984 38.4467 20.939 38.0872C20.5795 37.7278 20.3776 37.2403 20.3776 36.7319V25.2319H8.8776C8.36927 25.2319 7.88176 25.03 7.52232 24.6706C7.16287 24.3111 6.96094 23.8236 6.96094 23.3153C6.96094 22.8069 7.16287 22.3194 7.52232 21.96C7.88176 21.6005 8.36927 21.3986 8.8776 21.3986H20.3776V9.8986C20.3776 9.39027 20.5795 8.90276 20.939 8.54331C21.2984 8.18387 21.7859 7.98193 22.2943 7.98193Z" fill="#653490"/>
    </svg>
  </span>
  <span class="circle-chevron group-hover:colors group-expanded:colors group-expanded:rotate minusicon">
    <svg xmlns="http://www.w3.org/2000/svg" width="currentWidth" height="currentHeight" viewBox="0 0 46 46" fill="none">
      <path d="M9.58325 23H36.4166" stroke="#653490" stroke-width="3.83333" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
</div>
  </summary>

  <div class="accordion__content">
    {% if block.settings.custom-html  != blank %}
      <div class="prose">
        {{ block.settings.custom-html }}
      </div>
    {% else %}
      {{- content -}}
    {% endif %}
    
    {% if block.settings.liquid  != blank %}
   <div class="review-liquid">
     {{ block.settings.liquid }}
   </div>
      {% endif %}
  </div>
</details>