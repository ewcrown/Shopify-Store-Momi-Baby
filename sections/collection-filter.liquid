<div class="buttons-list {{ section.settings.class_name1 }}">
  <ul>
     {%- for block in section.blocks -%}
    <li class=""><a href="{{ block.settings.btn_link }}" class="nav-link {{ block.settings.class_name }}">{{ block.settings.btn_text }}</a></li>
   
    {%- endfor -%}
  </ul>
</div>

{% schema %}
  {
    "name": "Collection Filter",
    "settings": [
                {
          "type": "text",
          "id": "class_name1",
          "label": "Class Name"
          
        },
    ],
      "blocks": [
    {
      "name": "Filter Button",
      "type": "filter",
      "settings": [
               {
          "type": "text",
          "id": "class_name",
          "label": "Class Name"
          
        },

        {
          "type": "text",
          "id": "btn_text",
          "label": "Filter Button Text"
          
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Filter Button Link"
          
        }
      ]
    }
  ],
          "presets": [
    {
      "name": "Collection Filter"
    }
  ]
  }
{% endschema %}