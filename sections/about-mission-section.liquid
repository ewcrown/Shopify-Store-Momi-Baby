<section class="about-our-mission-section">
  <div class="section">
    <div class="section-stack">
      <div class="about-our-mission-inner">
        <div class="about-our-mission-left">
          <div class="about-our-mission-left-inner">
            <div class="title">{{ section.settings.title }}</div>
            <div class="subtitle">{{ section.settings.subtitle }}</div>
            <div class="image-wrapper desktop-image-wrapper">
              <img src="{{ section.settings.image |img_url: 'master' }}">
            </div>
          </div>
        </div>
        <div class="about-our-mission-right">
          <div class="content-wrapper">
            {{ section.settings.content }}
          </div>
          <div class="image-wrapper mobile-image-wrapper">
            <img src="{{ section.settings.image |img_url: 'master' }}">
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

