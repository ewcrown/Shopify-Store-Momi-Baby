<script src="https://player.vimeo.com/api/player.js"></script>

<script>
    document.getElementById('openVideo').addEventListener('click', function(event) {
        event.preventDefault();
        const lightbox = document.getElementById('videoLightbox');
        const iframe = document.getElementById('vimeoPlayer');
        
        // URLs for desktop and mobile
        const desktopVideoUrl = "https://player.vimeo.com/video/942394340?h=be46250883&autoplay=1";
        const mobileVideoUrl = "https://player.vimeo.com/video/943318006?h=9c153446c9&autoplay=1";
        
        // Detect device type
        const isMobile = window.innerWidth <= 768;
        const videoUrl = isMobile ? mobileVideoUrl : desktopVideoUrl;
        
        // Set video URL with autoplay and mute options
        iframe.src = videoUrl;
        lightbox.style.display = 'flex';

        // Initialize Vimeo Player and set volume to mute
        const player = new Vimeo.Player(iframe);
        player.setVolume(0); // Mute the video
    });

    // Close the lightbox and stop the video
    function closeLightbox() {
        const lightbox = document.getElementById('videoLightbox');
        const iframe = document.getElementById('vimeoPlayer');
        iframe.src = ""; // Reset iframe source to stop the video
        lightbox.style.display = 'none';
    }
</script>
