<style>
  .custom-video-wrapper{
    height: 100%;
  }
    .custom-video-wrapper .video {
     height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    }
    .custom-video-overlay{
      /* background-color: #FF0099; */
      opacity: 0.1;
      position: absolute;
      left: 0;
      top: 0;
      z-index: 2;
      height: 100%;
      width: 100%;
    }
      .bgvideo-item {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-size: cover;
        object-fit: cover;
        opacity: 0.1;
      }
